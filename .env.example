# Network monitoring
NETWORK_INTERFACE=auto

# Zeek
ZEEK_LOG_DIR=./data/zeek

# Normalized events
EVENT_OUTPUT_DIR=./data/events

# CICFlowMeter
CIC_FLOW_DIR=./data/cic/flows
CIC_WINDOW_DIR=./data/cic/windows
CIC_ROTATION_MINUTES=1

# Retention
EVENT_RETENTION_MINUTES=10

# Rotation
EVENT_ROTATION_MINUTES=15

# Application
LOG_LEVEL=INFO

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_FLOW_KEY=cic:flows
REDIS_RETENTION_SECONDS=300
